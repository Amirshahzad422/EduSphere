rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCourseInstructor(courseId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == request.auth.uid;
    }

    function isEnrolledInCourse(courseId) {
      return isAuthenticated() && (
        isCourseInstructor(courseId) ||
        exists(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + courseId))
      );
    }

    function getLiveClassCourseId(classId) {
      return get(/databases/$(database)/documents/liveClasses/$(classId)).data.courseId;
    }

    // =========================================================================
    // Users Collection (Private User Accounts)
    // =========================================================================
    // Contains private account information including email.
    // Read & write strictly restricted to the account owner.
    // Forces role to be 'student' at creation time (no client-side instructor self-creation).
    // On update, prevents modifying 'role', 'id', or 'email'.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.role == 'student';
      allow update: if isOwner(userId) &&
        (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
        (!('email' in resource.data) || request.resource.data.email == resource.data.email);
      allow delete: if false;
    }

    // =========================================================================
    // Public Profiles Collection (Publicly Readable Profiles & Leaderboard)
    // =========================================================================
    // Contains only non-sensitive public profile info (name, photoUrl, bio, xp, streak, badges, role).
    // Excludes email and private billing details.
    // Publicly readable so guests & students can view the global leaderboard and instructor bios.
    // Owner can create/update their public profile, with 'student' constraint on create and 'role' immutable on update.
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        (!('role' in resource.data) || request.resource.data.role == resource.data.role) &&
        (!('id' in resource.data) || request.resource.data.id == resource.data.id);
      allow delete: if false;
    }

    // =========================================================================
    // Courses Collection
    // =========================================================================
    // Published courses are publicly readable by students and guests.
    // Owning instructor can create, edit, or delete the course.
    // Enrolled students can atomically update ONLY the aggregate rating fields upon submitting reviews.
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.instructorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.instructorId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + courseId)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingSum', 'ratingCount', 'averageRating', 'rating', 'reviewCount'])
        )
      );
      allow delete: if isAuthenticated() && resource.data.instructorId == request.auth.uid;
    }

    // =========================================================================
    // Reviews Collection (STUDENT RATINGS & REVIEWS)
    // =========================================================================
    // Deterministic doc ID: ${userId}_${courseId}
    // Only enrolled students can create/update their review.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.courseId is string &&
        exists(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + request.resource.data.courseId)) &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5;
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isCourseInstructor(resource.data.courseId)
      );
    }

    // =========================================================================
    // Enrolments Collection (CRITICAL ACCESS CONTROL)
    // =========================================================================
    // 1. Reads are restricted to the enrolled student (request.auth.uid == resource.data.userId)
    //    or the instructor of the enrolled course.
    //    Students CANNOT query or view other students' enrolment records.
    // 2. Writes (creation & progress updates) are restricted to the student's own UID.
    match /enrolments/{enrolmentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isCourseInstructor(resource.data.courseId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false; // Enrolments cannot be deleted by client apps
    }

    // =========================================================================
    // Quizzes & Quiz Attempts Collection
    // =========================================================================
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isCourseInstructor(request.resource.data.courseId);
      allow update, delete: if isAuthenticated() && isCourseInstructor(resource.data.courseId);
    }

    match /quizAttempts/{attemptId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        isCourseInstructor(resource.data.courseId)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // =========================================================================
    // Certificates Collection
    // =========================================================================
    // Publicly readable so that external verification links & QR codes work without logging in.
    // Client write is strictly prohibited — certificates are issued server-side by the Cloudflare Worker.
    match /certificates/{certId} {
      allow read: if true;
      allow write: if false;
    }

    // =========================================================================
    // Live Classes Collection (STRICT ACCESS CONTROL)
    // =========================================================================
    match /liveClasses/{classId} {
      // 1. Create: Only the instructor who owns the specified courseId
      allow create: if isAuthenticated() &&
        request.resource.data.instructorId == request.auth.uid &&
        isCourseInstructor(request.resource.data.courseId);

      // 2. Update & Delete: Only the owning instructor who owns the course
      allow update, delete: if isAuthenticated() &&
        resource.data.instructorId == request.auth.uid &&
        isCourseInstructor(resource.data.courseId);

      // 3. Read: ONLY the owning instructor OR a student enrolled in courseId
      allow read: if isAuthenticated() && (
        (resource.data.instructorId == request.auth.uid && isCourseInstructor(resource.data.courseId)) ||
        exists(/databases/$(database)/documents/enrolments/$(request.auth.uid + '_' + resource.data.courseId))
      );

      // -----------------------------------------------------------------------
      // Realtime In-Class Participants Subcollection
      // -----------------------------------------------------------------------
      match /participants/{participantId} {
        // Read: ONLY owning instructor OR enrolled student of this class's course
        allow read: if isAuthenticated() && isEnrolledInCourse(getLiveClassCourseId(classId));

        // Create / Update: Participant themselves AND enrolled in the course
        allow create, update: if isAuthenticated() &&
          request.auth.uid == participantId &&
          isEnrolledInCourse(getLiveClassCourseId(classId));

        // Delete: Participant themselves leaving OR owning instructor removing a participant
        allow delete: if isAuthenticated() && (
          request.auth.uid == participantId ||
          isCourseInstructor(getLiveClassCourseId(classId))
        );
      }

      // -----------------------------------------------------------------------
      // Realtime In-Class Messages Subcollection
      // -----------------------------------------------------------------------
      match /messages/{messageId} {
        // Read: ONLY owning instructor OR enrolled student of this class's course
        allow read: if isAuthenticated() && isEnrolledInCourse(getLiveClassCourseId(classId));

        // Create: Sender themselves AND enrolled in the course
        allow create: if isAuthenticated() &&
          request.resource.data.senderId == request.auth.uid &&
          isEnrolledInCourse(getLiveClassCourseId(classId));

        // In-class messages are immutable
        allow update, delete: if false;
      }
    }
  }
}
